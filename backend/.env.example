# ==============================================================================
# UniMindKidz Backend Environment Variables
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example for local PostgreSQL on droplet: postgresql://unimind_user:StrongPassword123@localhost:5432/unimind_db?schema=public
# Example for DigitalOcean Managed Database: postgresql://doadmin:SECRET@db-postgresql-nyc1-12345.b.db.ondigitalocean.com:25060/defaultdb?sslmode=require
DATABASE_URL="postgresql://unimind_user:YourSecurePassword@localhost:5432/unimind_db?schema=public"

# JWT Authentication Secret (Generate a strong random string: `openssl rand -hex 32`)
JWT_SECRET="generate_a_random_secure_secret_string_here"
JWT_EXPIRES_IN="7d"

# Initial Admin Credentials (used during `npm run db:seed`)
ADMIN_EMAIL="denise@theunimindproject.org"
ADMIN_PASSWORD="UniMindAdmin2024!"

# Frontend URL for CORS (e.g., https://your-frontend.vercel.app or http://your-droplet-ip)
FRONTEND_URL="https://your-frontend-domain.com"

# Cloudinary Storage for Audio Recordings (Optional, falls back to local /uploads if not set)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
